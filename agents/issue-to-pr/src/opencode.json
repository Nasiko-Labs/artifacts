{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai-chat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI (chat completions)",
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-4o-mini": {
          "name": "GPT-4o mini",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "python -m pytest*": "allow",
      "pytest*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "git diff*": "allow",
      "*": "deny"
    }
  }
}
